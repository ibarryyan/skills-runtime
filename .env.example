# OpenAI-compatible chat completions endpoint.
LLM_BASE_URL=https://your-api.example.com/v1
LLM_API_KEY=your-api-key
LLM_MODEL=your-model
LLM_TIMEOUT=120

# TLS verification:
# true  = verify server certificate (recommended)
# false = disable certificate verification (development/test only)
LLM_SSL_VERIFY=true

# If your internal service uses a private/self-signed CA, point this to the CA PEM file.
# Example:
# LLM_CA_BUNDLE=/path/to/company-root-ca.pem
LLM_CA_BUNDLE=
